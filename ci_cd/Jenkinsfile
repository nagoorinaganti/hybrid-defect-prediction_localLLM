pipeline {

    agent any

    stages {

        stage('Pull Source Code') {

            steps {

                echo 'Pulling latest code from GitHub...'

                git branch: 'main',
                url: 'https://github.com/nagoorinaganti/hybrid-defect-prediction_localLLM.git'
            }
        }

        stage('Install Dependencies') {

            steps {

                bat '"C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" -m pip install -r requirements.txt'
            }
        }

        stage('Feature Engineering') {

            steps {

                bat '"C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" models/feature_engineering.py'
            }
        }

        stage('Train ML Model') {

            steps {

                bat '"C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" models/train_model.py'
            }
        }

        stage('Run Hybrid Prediction') {

            steps {

                bat '"C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" main.py'
            }
        }

        stage('Quality Gate Validation') {

            steps {

                echo 'Evaluating quality gate...'
            }
        }

        stage('Dashboard Update') {

            steps {

                echo 'Dashboard updated successfully.'
            }
        }
    }

    post {

        success {

            echo 'Pipeline executed successfully.'
        }

        failure {

            echo 'Pipeline failed.'
        }
    }
}