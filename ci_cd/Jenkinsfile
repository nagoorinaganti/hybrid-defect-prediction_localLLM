pipeline {

    agent any

    stages {

        // -----------------------------------------
        // Pull Latest Source Code
        // -----------------------------------------

        stage('Pull Source Code') {

            steps {

                echo 'Pulling latest code from GitHub...'

                git branch: 'main',
                url: 'https://github.com/nagoorinaganti/hybrid-defect-prediction_localLLM.git'
            }
        }


        // -----------------------------------------
        // Install Dependencies
        // -----------------------------------------

        stage('Install Dependencies') {

            steps {

                bat '"C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" -m pip install -r requirements.txt'
            }
        }


        // -----------------------------------------
        // Generate Dataset
        // -----------------------------------------

        stage('Generate Dataset') {

            steps {

                echo 'Generating dataset...'

                bat '"C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" data/generate_dataset.py'
            }
        }


        // -----------------------------------------
        // Train ML Model
        // -----------------------------------------

        stage('Train ML Model') {

            steps {

                echo 'Training ML models...'

                bat '"C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" models/train_model.py'
            }
        }


        // -----------------------------------------
        // Generate Experimental Graphs
        // -----------------------------------------

        stage('Generate Graphs') {

            steps {

                echo 'Generating evaluation graphs...'

                bat '"C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" graphs/generate_graphs.py'
            }
        }


        // -----------------------------------------
        // Run Hybrid Prediction
        // -----------------------------------------

        stage('Run Hybrid Prediction') {

            steps {

                echo 'Running hybrid prediction engine...'

                bat '"C:\\Users\\ADMIN\\AppData\\Local\\Programs\\Python\\Python314\\python.exe" main.py'
            }
        }


        // -----------------------------------------
        // Quality Gate Validation
        // -----------------------------------------

        stage('Quality Gate Validation') {

            steps {

                echo 'Evaluating quality gate threshold...'
            }
        }


        // -----------------------------------------
        // Dashboard Update
        // -----------------------------------------

        stage('Dashboard Update') {

            steps {

                echo 'Dashboard updated successfully.'
            }
        }


        // -----------------------------------------
        // Archive Reports
        // -----------------------------------------

        stage('Archive Reports') {

            steps {

                archiveArtifacts artifacts: 'reports/*', fingerprint: true
            }
        }
    }


    // -----------------------------------------
    // Post Build Actions
    // -----------------------------------------

    post {

        success {

            echo 'Pipeline executed successfully.'
        }

        failure {

            echo 'Pipeline failed.'
        }
    }
}